# ==============================================================================
# DocFlow Environment Configuration Template (.env.example)
# Copy this file to backend/.env and update values for your environment.
# DO NOT commit the real .env file with production secrets.
# ==============================================================================

# Django Application Settings
SECRET_KEY=your-secure-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Settings
DB_NAME=docflow_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend API Base URL (Used by Angular proxy or direct connection)
VITE_API_BASE_URL=http://localhost:8000/api
